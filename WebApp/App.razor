<Router AppAssembly="@typeof(App).Assembly" NotFoundPage="typeof(Pages.NotFound)"
        AdditionalAssemblies="new[] { typeof(RclPinesIntranet.Pages.Login).Assembly} ">
    <Found Context="routeData">

        @* Use the wrapper component as the DefaultLayout *@
        <RouteView RouteData="@routeData" DefaultLayout="@typeof(DefaultLayoutWrapper)" />
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>  
</Router>