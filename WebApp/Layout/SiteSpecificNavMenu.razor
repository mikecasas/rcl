                    </NavLink>
                </div>
            </Authorized>

        </AuthorizeView>


      
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="api-header-test">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Api Herader Test
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="api-header-test">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Api Herader Test
            </NavLink>
        </div>
     

