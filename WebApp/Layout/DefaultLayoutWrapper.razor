@inherits LayoutComponentBase
@* This component IS the MainLayout, plus its custom parameters. *@

<RclPinesIntranet.Layout.PinesIntranet.MainLayout>
    <NavContent>
        <SiteSpecificNavMenu />
    </NavContent>

    <AuthorizationSection>
        <RclPinesIntranet.Components.AuthLinks TenantNbr="1" LoginEndpoint="https://tws.ppines.com/saas-admin/windows-auth/login"></RclPinesIntranet.Components.AuthLinks>
    </AuthorizationSection>

    <HeaderContent>
        <RclPinesIntranet.Layout.PinesIntranet.BudgetPortalSites BaseRoute="https://localhost:9999" HighlightLinkNbr="1" />

    </HeaderContent>
    <FooterContent>
      
    </FooterContent>
    
    @* Crucially, the ChildContent passed to this wrapper goes to the @Body of MainLayout *@
    <Body>
        @Body 
    </Body>
</RclPinesIntranet.Layout.PinesIntranet.MainLayout>