@page "/"

@inject Notifications Ns

<PageTitle>Home</PageTitle>

<h1>Hello, Project!</h1>

Welcome to your new app. There is no auth on this page!


<RadzenTemplateForm Data="@Cat" Submit="@(async (string args) => { await Submit(args); })">

 
    <RadzenButton ButtonType="ButtonType.Submit" Icon="search" Text="Search" />

</RadzenTemplateForm>

<h3>Main Auth App</h3>

<AuthorizeView>
    <Authorized>
        <p class="text-success">Parent project sees: User is logged in.</p>
    </Authorized>
    <NotAuthorized>
        <p class="text-danger">Parent project sees: User is NOT logged in.</p>
    </NotAuthorized>
</AuthorizeView>


@code {

    string Cat = "Home";

    async Task Submit(string arg)
    {
        Ns.NotifyThemSuccess(arg);
    }
}