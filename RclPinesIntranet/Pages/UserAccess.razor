@page "/user-access"

@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Authorization
@using Tsd.Utils

@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ITokenService TokenSvc

@attribute [Authorize]

<h3>User Information</h3>

<button @onclick="GetClaimsPrincipalData" class="rz-button rz-button-md rz-variant-filled rz-primary rz-shade-default mt-3 mb-5">
    <span class="bi bi-person" style="font-size: 1.1rem;">Get User Information</span>
</button>

<p>@AuthMessage</p>

@if (claims.Count() > 0)
{
    <ul>
        @foreach (var claim in claims)
        {
            <li>@claim.Type: @claim.Value</li>
        }
    </ul>

    <ul>
        <li>Token Issued: @TokenIssuedAt</li>
        <li>Token Expires: @TokenExpiresAt</li>
        <li>Token Not Before: @TokenNotBefore</li>
    </ul>
}

@if (DisplayToken)
{
    <div style="width:1200px;overflow:auto">
        <pre>@AccessTokenString</pre>
    </div>
}

@code {

    private string? AccessTokenString = string.Empty;
    private string? AuthMessage;
    private IEnumerable<Claim> claims = Enumerable.Empty<Claim>();

    private string? TokenIssuedAt = string.Empty;
    private string? TokenExpiresAt = string.Empty;
    private string? TokenNotBefore = string.Empty;


    [CascadingParameter]
    public AppVariables? AppVars { get; set; }

    private bool DisplayToken = false;
      
    protected override void OnParametersSet()
    {
        DisplayToken = AppVars?.DisplayAccessToken ?? false;
    }   

    private async Task GetClaimsPrincipalData()
    {    
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity.IsAuthenticated)
        {
            AuthMessage = $"User {user.Identity.Name} is authenticated.";
            claims = user.Claims;
            FormatTokenTimes(user);

            AccessTokenString = await TokenSvc.GetTokenAsync();                        

        }
        else
        {
            AuthMessage = "The user is NOT authenticated.";
        }
    }

    private void FormatTokenTimes(ClaimsPrincipal cp)
    {
        var IssAt = cp.FindFirst(c => c.Type == "iat")?.Value;
        var ExpAt = cp.FindFirst(c => c.Type == "exp")?.Value;
        var NotBefore = cp.FindFirst(c => c.Type == "nbf")?.Value;

        DateTimeOffset DtoIssAt = DateTimeOffset.FromUnixTimeSeconds(long.Parse(IssAt ?? "0"));
        DateTimeOffset DtoExpAt = DateTimeOffset.FromUnixTimeSeconds(long.Parse(ExpAt ?? "0"));
        DateTimeOffset DtoNotBefore = DateTimeOffset.FromUnixTimeSeconds(long.Parse(NotBefore ?? "0"));

        DateTime IssuedAt = DtoIssAt.DateTime;
        DateTime ExpiresOn = DtoExpAt.DateTime;
        DateTime NotBeforeOn = DtoNotBefore.DateTime;

        TokenIssuedAt = FormatMyDate(IssuedAt);
        TokenExpiresAt = FormatMyDate(ExpiresOn); 
        TokenNotBefore = FormatMyDate(NotBeforeOn);
    }

    private string FormatMyDate(DateTime dt)
    {
        return dt.ToEasternTimeZone().ToShortDateString() + " " + dt.ToEasternTimeZone().ToLongTimeString();
    }
}