@page "/login/{tenantNbr}"
@inject NavigationManager Nav

<PageTitle>Login</PageTitle>

<p class="lead">@Message</p>

<h3>Pembroke Pines Intranet Authentication</h3>

<button @onclick="OnValid" type="button" disabled="@IsDisabled" class="btn btn-primary mt-3 mb-5">
    <span class="bi bi-person" style="font-size: 1.2rem;"> Login</span>
</button>

@if (@IsDisabled)
{
    <h4 class="mb-5">Authenticating......</h4>
    <RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" Style="margin-bottom: 20px" />
}

@code {

    [Inject]
    public IServiceBase? ServiceBase { get; set; }

    [Inject]
    public IServiceBaseConfig? ServiceBaseConfig { get; set; }

    [Inject]
    public IAuthenticationService? AuthenticationService { get; set; }

    LoginModel user = new LoginModel();
    string Message = string.Empty;
    bool IsDisabled = false;
    private int CurrentCount = 0;
    private int TenNbr;  
    string Ep = string.Empty;

    [Parameter]
    public string? TenantNbr { get; set; }      

    [Parameter]
    public string? RedirectedPage { get; set; }

    [Parameter]
    public string? ReturnSuccessValue { get; set; }

    protected override void OnInitialized()
    {        
        Ep = Nav.QueryString("Ep");

        bool success = int.TryParse(TenantNbr, out int number);
        if (success)
        {
            TenNbr = number;
        }
        else
        {
            TenNbr = -1;
        }
    }    

    private async Task OnValid()
    {
        IsDisabled = true;
        var rslt = await AuthenticationService.LoginAsync(TenNbr, Ep);
        GotoPage(rslt);
    }

    private void GotoPage(LoginResult l)
    {
        if (l.IsSuccess)
        {
            if (string.IsNullOrEmpty(l.DefaultPage))
            {
                Nav.NavigateTo(Nav.BaseUri);
            }
            else
            {
                if (l.DefaultPage == ReturnSuccessValue)
                {
                    Console.WriteLine(Nav.BaseUri);
                    Console.WriteLine(l);

                    Nav.NavigateTo(Nav.BaseUri + RedirectedPage);
                }
                else
                {
                    Nav.NavigateTo(Nav.BaseUri);
                }
            }
        }
        {
            CurrentCount++;
            Message = $"Invalid Logon Attempt. Attempt {CurrentCount}";
            IsDisabled = false;
        }
    }
}


