@inject AuthRCL.Services.RclAuthService Auth

<div class="border p-3">
    @if (!Auth.IsAuthenticated)
    {
        <h4>Login Widget To Test</h4>       
        <button class="btn btn-primary mt-3" @onclick="DoLogin">Login</button>
    }
    else
    {
        <h4>You are logged in</h4>
        <button class="btn btn-secondary mt-3" @onclick="DoLogout">Logout</button>
    }
</div>

@code {
    string User = "";
    string Pass = "";
    async Task DoLogin() => await Auth.LoginAsync(User, Pass);
    async Task DoLogout() => await Auth.LogoutAsync();
}
