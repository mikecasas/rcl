@inherits LayoutComponentBase

<HeadContent>
    <RadzenTheme Theme="material" />
</HeadContent>

<RadzenComponents />

<div class="page">

    @if (SidebarWidth != "0")
    {
        <div class="sidebar" style="width:@SidebarWidth">
            @NavContent
        </div>
    }     

    <main>
          <div class="d-flex bd-highlight top-row">
            <div class="p-2 flex-grow-1 bd-highlight">
                @HeaderContent
            </div>

            <div class="p-2 bd-highlight">
                @AuthorizationSection
            </div>
        </div>

        <article class="content px-4">
            @* The main page content *@
            @Body
        </article>

        <div class="footer-row px-4">
            @* Slot for custom footer content *@
            @FooterContent
        </div>
    </main>
</div>

@code {

    /// <summary>
    /// Customize the width of the sidebar. The default value is "250px". A value of 0 will hide the sidebar completely.
    /// </summary>
    [Parameter]
    public string SidebarWidth { get; set; } = "250px";

    // This Content will be injected where @NavContent is placed
    [Parameter]
    public RenderFragment? NavContent { get; set; }

    [Parameter]
    public RenderFragment? HeaderContent { get; set; } // New Slot
    [Parameter]
    public RenderFragment? AuthorizationSection { get; set; } // New Slot

    [Parameter]
    public RenderFragment? FooterContent { get; set; } // New Slot
}